# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit your actual key.
#
# NOTE: this key still ends up readable inside the built extension's JS files
# (dist/background/background.js) since browser extensions can't truly hide
# secrets from their own runtime. This only keeps it out of git/source control,
# not out of the shipped build. Fine for personal use; do not publish this
# built extension publicly with a real key baked in.

GROQ_API_KEY=
