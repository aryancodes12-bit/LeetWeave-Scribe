{
  "manifest_version": 3,
  "name": "LeetWeave Scribe (LWS) — LeetCode to GitHub",
  "version": "0.1.0",
  "description": "LeetWeave Scribe automatically organizes and pushes accepted LeetCode solutions to your GitHub repo, by topic, difficulty, or your own custom structure.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*", "https://api.groq.com/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
